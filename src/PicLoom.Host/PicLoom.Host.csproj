<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PicLoom.Host</AssemblyName>
    <RootNamespace>PicLoom.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\PicLoom.Api\PicLoom.Api.csproj" />
  </ItemGroup>

  <Target Name="CopyPicLoomWebAssets" AfterTargets="Build">
    <ItemGroup>
      <PicLoomWebAsset Include="..\PicLoom.Api\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PicLoomWebAsset)"
          DestinationFiles="@(PicLoomWebAsset->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(PicLoomWebAsset)' != ''" />
  </Target>
</Project>
